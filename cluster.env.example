# Copy to cluster.env and edit. Sourced by every .slurm script (cluster.env is git-ignored).
export CONDA_ENV=/path/to/conda/env            # python env with torch, transformers (Qwen3.5), peft, vllm
export EXTRA_PYTHONPATH=                        # optional extra site-packages
export QWEN_PATH=/path/to/Qwen3.5-4B            # local HF checkpoint dir (safetensors)
export MERGED_DIR=/path/to/scratch/merged       # where eval_ckpt.py writes merged LoRA checkpoints
export BIOREASONCELL=/path/to/BioReasonCell     # checkout providing bioreason_cell.rl.exact_policy (needed by rl/exact_grpo.py)
